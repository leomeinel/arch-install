#!/usr/bin/env bash

# Fail on error
set -e

# Define functions
log_err() {
    /usr/bin/logger -s -p local0.err <<<"$(basename "${0}"): ${*}"
}
var_invalid_err_exit() {
    log_err "'${1}' is invalid in '${2}'."
    exit 1
}

# If current user is not in group wheel, don't do anything
if id -nG "${UID}" | grep -vwq "wheel"; then
    log_err "You can only run this script if you are in group 'wheel'."
    exit 1
fi

# Run chezmoi update for each user
USERS=(
    REPLACE_USERS
)
for user in "${USERS[@]}"; do
    ## Check if "${user}" is valid
    [[ -n "${user}" ]] ||
        continue
    id "${user}" >/dev/null 2>&1 ||
        var_invalid_err_exit "${user}" "USERS"

    case "$(id -u "${user}")" in
    0)
        /usr/bin/doas /usr/bin/systemd-run -P --wait --system -E HOME=/"${user}" -M "${user}"@ /bin/sh -c 'chezmoi update'
        ;;
    "${UID}")
        /bin/sh -c 'chezmoi update'
        ;;
    *)
        /usr/bin/doas /usr/bin/systemd-run -P --wait --user -M "${user}"@ /bin/sh -c 'chezmoi update'
        ;;
    esac
done
